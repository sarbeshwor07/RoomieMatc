{
  "name": "roomiematch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.client.config.js",
    "dev:client": "vite --config vite.client.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "node scripts/build.js",
    "build:all": "npm run build:client && npm run build:admin",
    "build:client": "vite build --config vite.client.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "lint": "oxlint apps shared",
    "preview": "vite preview --config vite.client.config.js",
    "preview:client": "vite preview --config vite.client.config.js",
    "preview:admin": "vite preview --config vite.admin.config.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  }
}
